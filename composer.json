{
    "name": "mouseketeers/silverstripe-messages",
    "description": "A SilverStripe module to send messages to users",
    "authors": [
        {
            "name": "Mouseketeers",
            "email": "support@mouseketeers.dk",
            "homepage": "http://www.mouseketeers.dk"
        }
    ],      
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "messages",
        "email"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5.4",
        "silverstripe/admin": "^2",
        "silverstripe/assets": "^2",
        "symbiote/silverstripe-queuedjobs": "^5"
    },
    "minimum-stability": "stable",
    "extra": {
        "installer-name": "messages",
        "expose": [
            "client"
        ]
    },
    "autoload": {
        "psr-4": {
            "Mouseketeers\\Messages\\": "src/"
        }
    }         
}
