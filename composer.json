{
    "name": "mouseketeers/silverstripe-messages",
    "description": "A SilverStripe module to send messages to users",
    "authors": [
        {
            "name": "Mouseketeers",
            "email": "support@mouseketeers.dk",
            "homepage": "http://www.mouseketeers.dk"
        }
    ],      
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "messages",
        "email"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^7.1 || ^8.0",
        "silverstripe/framework": "^4.0",
        "silverstripe/admin": "^1.0",
        "silverstripe/assets": "^1.0",
        "silverstripe/subsites": "^2.0",
        "symbiote/silverstripe-queuedjobs": "^4.0"
    },
    "suggest": {
        "silverstripe/subsites": "For multi-site message management",
        "symbiote/silverstripe-queuedjobs": "For background message processing"
    },
    "minimum-stability": "stable",
	"extra": {
		"installer-name": "messages"
	},
    "autoload": {
        "psr-4": {
            "Mouseketeers\\Messages\\": "src/"
        }
    }         
}